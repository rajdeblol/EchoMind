# Pharos Configuration
PHAROS_PRIVATE_KEY=your_private_key_here
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com  # Testnet
# PHAROS_RPC_URL=https://rpc.pharos.xyz  # Mainnet
PHAROS_CHAIN_ID=688689  # Testnet
# PHAROS_CHAIN_ID=1672  # Mainnet

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Alternative: OPENROUTER_API_KEY=your_key_here

# Vercel KV Configuration
KV_REST_API_URL=your_vercel_kv_url
KV_REST_API_TOKEN=your_vercel_kv_token

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000