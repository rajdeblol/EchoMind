# Pharos Configuration
PHAROS_PRIVATE_KEY=your_private_key_here
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com  # Testnet
# PHAROS_RPC_URL=https://rpc.pharos.xyz  # Mainnet
PHAROS_CHAIN_ID=688689  # Testnet
# PHAROS_CHAIN_ID=1672  # Mainnet

# Database Configuration
DB_PATH=./echomind.db

# OpenAI Configuration (for Next.js app)
OPENAI_API_KEY=your_openai_api_key_here
VERCEL_KV_REST_API_URL=your_vercel_kv_url
VERCEL_KV_REST_API_TOKEN=your_vercel_kv_token
VERCEL_KV_REST_API_READ_ONLY_TOKEN=your_vercel_kv_read_only_token